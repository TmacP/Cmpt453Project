[bootstrap]
main_collection = /main/main.collectionc
render = /orthographic/render/orthographic.renderc

[script]
shared_state = 1

[display]
width = 360
height = 640
high_dpi = 0

[android]
input_method = HiddenInputField

[project]
title = Koi Keep
publisher = Cozy Cachet
developer = Tristen MacPherson
dependencies#0 = https://github.com/defold/extension-websocket/archive/master.zip
dependencies#1 = https://github.com/subsoap/defsave/archive/master.zip
dependencies#2 = https://github.com/britzl/defold-orthographic/archive/master.zip
dependencies#3 = https://github.com/Insality/druid/archive/refs/tags/1.0.zip
dependencies#4 = https://github.com/Insality/defold-tweener/archive/refs/tags/3.zip
dependencies#5 = https://github.com/Insality/panthera/archive/refs/tags/runtime.4.zip

[tilemap]
max_tile_count = 5000

[render]
clear_color_red = 0.04
clear_color_green = 0.38
clear_color_blue = 0.88

[html5]
show_made_with_defold = 0
show_fullscreen_button = 0
show_console_banner = 0
splash_image = /main/assets/blank.png

[input]
game_binding = /builtins/input/all.input_bindingc

